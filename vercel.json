{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "vercel.cjs",
      "installCommand": "echo 'api is pre-bundled (npm run bundle:api), nothing to install'",
      "buildCommand": "echo 'api is pre-bundled (npm run bundle:api)'"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/([^.]*)", "destination": { "service": "web", "path": "/index.html" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
