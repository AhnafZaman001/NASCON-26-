{
  "name": "nascon-26",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nascon/web",
    "dev:api": "npm run dev -w @nascon/api",
    "dev:worker": "npm run dev -w @nascon/worker",
    "build": "npm run build -w @nascon/web",
    "start:api": "npm run start -w @nascon/api",
    "start:worker": "npm run start -w @nascon/worker",
    "lint": "npm run lint -w @nascon/web",
    "typecheck": "npm run typecheck -w @nascon/api -w @nascon/worker",
    "bundle:api": "esbuild apps/api/src/app.ts --bundle --platform=node --format=cjs --target=node20 --outfile=apps/api/dist/app.cjs --external:msgpackr-extract --log-level=warning"
  }
}
