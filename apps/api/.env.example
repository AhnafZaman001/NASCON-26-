PORT=4000
# Comma-separated origins allowed to call the API (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Supabase service role (server only - never put this in apps/web)
SUPABASE_URL=https://bjbwdtlznujrresmhhyv.supabase.co
SUPABASE_SECRET_KEY=

# BullMQ email queue (same Redis as apps/worker)
REDIS_URL=redis://127.0.0.1:6379

# --- Email alerts (I4) via Nodemailer / SMTP. Real values live ONLY in .env (never in apps/web). ---
# The queued-email worker (apps/worker) reads the same SMTP_* vars and MAIL_FROM.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail app password, written WITHOUT spaces
SMTP_PASS=
MAIL_FROM="NASCON X 26 <your-address@gmail.com>"
