PORT=4000
# Comma-separated origins allowed to call the API (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Supabase service role (server only - never put this in apps/web)
SUPABASE_URL=https://bjbwdtlznujrresmhhyv.supabase.co
SUPABASE_SECRET_KEY=

# BullMQ email queue (same Redis as apps/worker)
REDIS_URL=redis://127.0.0.1:6379

# --- Email alerts (I4) via Nodemailer / SMTP. Real values live ONLY in .env (never in apps/web). ---
# The queued-email worker (apps/worker) reads the same SMTP_* vars and MAIL_FROM.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail app password, written WITHOUT spaces
SMTP_PASS=
MAIL_FROM="NASCON X 26 <your-address@gmail.com>"
# Shared secret for POST /api/jobs/send-emails (the database scheduler sends it). Generate: openssl rand -hex 24
CRON_SECRET=

# --- WhatsApp via Twilio (M7). Sandbox works on localhost: the API polls Twilio every 5 s. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox number (default)
# TWILIO_WORKSPACE_ID=                          # which workspace gets sandbox messages (default: newest)
# PUBLIC_API_URL=https://your-api.example.com  # when deployed: enables signed webhooks + status callbacks

# --- Google Calendar (M9 / I3) ---
# Google Cloud Console > APIs & Services: enable "Google Calendar API", configure the OAuth consent screen
# (add every demo user as a TEST USER while the app is in testing), then create an OAuth client of type
# "Web application" and register the redirect URI below on it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to <PUBLIC_API_URL>/api/calendar/callback, or http://localhost:4000/api/calendar/callback locally.
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/callback
# Where the browser returns after consent (default http://localhost:5173).
# Base URL for the "Open the lead" link inside alert emails (set to your production URL when deployed)
# WEB_URL=http://localhost:5173
# Encrypts stored OAuth tokens (AES-256-GCM). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
