# Supabase (public keys only in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secrets belong in .env.local and must never use the NEXT_PUBLIC_ prefix:
# SUPABASE_SERVICE_ROLE_KEY=
# TWILIO_AUTH_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SUPABASE_SECRET_KEY=        (used by src/lib/supabase-admin.ts)
# REDIS_URL=redis://127.0.0.1:6379   (BullMQ email queue, see apps/worker)

# --- Email alerts (I4) via Nodemailer / SMTP. Real values live ONLY in .env.local and Vercel. ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Gmail app password, written WITHOUT spaces
SMTP_PASS=
MAIL_FROM="NASCON X 26 <your-address@gmail.com>"
