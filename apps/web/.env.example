# Supabase (public keys only in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secrets belong in .env.local and must never use the NEXT_PUBLIC_ prefix:
# SUPABASE_SERVICE_ROLE_KEY=
# TWILIO_AUTH_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SUPABASE_SECRET_KEY=        (used by src/lib/supabase-admin.ts)
# REDIS_URL=redis://127.0.0.1:6379   (BullMQ email queue, see apps/worker)
